# ==============================================================================
# PlacementPilot Environment Configuration Example
# Copy this file to .env (or backend/.env) and populate with your local values.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=True
APP_NAME=PlacementPilot
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate a secure key in production (e.g. `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=dev_insecure_secret_key_change_in_production_min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Frontend & Backend URLs
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:8000

# PostgreSQL Database Configuration
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placementpilot_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Storage Settings
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_BYTES=5242880  # 5 MB

# AI Provider Configuration (Optional during Phase 1-14; Provider-independent)
# Supported AI_PROVIDER values: gemini, openai, anthropic, mock
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
